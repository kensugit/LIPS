<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="$(CatalogRuntime)/*.dll" Exclude="$(CatalogRuntime)/CatalogSearch.Web.dll" />
  </ItemGroup>
  <Target Name="CheckCatalogRuntime" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(CatalogRuntime)/CatalogSearch.Infrastructure.dll')" Text="Specify -p:CatalogRuntime=path/to/existing/catalog/runtime" />
  </Target>
</Project>
