+function updateDownloadButton() {
+ $('download-csv').disabled = searchPending || data.length === 0;
+}
+
+function setSearchPending(pending) {
+ searchPending = pending;
+ $('busy').hidden = !pending;
+ $('search').inert = pending;
+ updateDownloadButton();
+}
+
+function searchQuery() {
+ const query = new URLSearchParams(new FormData($('search')));
+ query.set('available', $('available').checked ? 'true' : 'false');
+ return query;
+}
+
+function validPriceRange() {
+ const min = $('priceMin').value;
+ const max = $('priceMax').value;
+ return min === '' || max === '' || Number(min) <= Number(max);
+}
+
+function showSearchResults(result) {
+ data = result.rows;
+ $('csv-status').textContent = result.capped
+  ? '検索上限に達したため、CSVも先頭2,000件のみです。条件を絞ると残りの商品も検索できます。'
+  : '検索結果 ' + data.length.toLocaleString() + '件を現在の並び順でCSV出力します。';
+ $('interpreted').textContent = result.conditions?.length
