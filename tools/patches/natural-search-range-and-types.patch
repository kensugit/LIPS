+    [InlineData("オレンジピール")]
+    public void ColorInsideNamesIsNotAType(string text)
+    {
+        var result = NaturalSearch.Parse(new(Text: text));
+        Assert.Null(result.Filter.ProductType);
+        Assert.Equal(text, result.Filter.Text);
+    }
+
