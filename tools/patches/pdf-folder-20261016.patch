diff --git a/catalog-search-poc/tools/pdf-folder/parse_folder_pdf.py b/catalog-search-poc/tools/pdf-folder/parse_folder_pdf.py
new file mode 100644
index 0000000..ecef824
--- /dev/null
+++ b/catalog-search-poc/tools/pdf-folder/parse_folder_pdf.py
@@ -0,0 +1,137 @@
+"""Read-only PDF adapter. Source bytes and every source row remain evidence."""
+import contextlib
+import hashlib
+import io
+import json
+import re
+import sys
+from collections import Counter
+from pathlib import Path
+
+# Private, version-pinned dependencies in the Web package. Never pip-install or
+# modify the existing renderer environment at runtime. Windows tests use their
+# isolated dependency directory as before.
+_vendor = Path(__file__).with_name("vendor") / "linux-cp312"
+_vendor_problem = False
+if sys.platform.startswith("linux") and _vendor.is_dir():
+    import platform
+    if sys.version_info[:2] != (3, 12) or platform.machine().lower() not in ("x86_64", "amd64"):
+        _vendor_problem = True
+    else:
+        sys.path.insert(0, str(_vendor))
+
+PARSERS = {"KINOSHITA": "kinoshita", "TOYOTSU": "toyotsu", "FINESSE": "finesse",
+           "WINE_EXPERIENCE": "wine-experience", "ROYAL_OF_JAPAN": "royal", "ARCAN": "arcan",
+           "DAIEI": "daiei", "DIONY": "diony"}
+
+
+def kinoshita(data):
+    from pypdf import PdfReader
+    from supplier_pdfs import row_contract, unique
+    reader = PdfReader(io.BytesIO(data))
+    if reader.is_encrypted:
+        raise ValueError("encrypted")
+    rows = []
+    # Numeric suffix is anchored from the right: digits in the wine name cannot shift columns.
+    pattern = re.compile(r"^(?P<sku>\d{8})\s*(?P<name>.+?)\s+(?P<volume>\d+)\s+(?P<case>\d+)\s+"
+                         r"(?P<stock>\d+(?:CS)?)\s+(?P<price>\d[\d,]*)\s+(?:(?P<vintage>\d{1,4})\s+)?"
+                         r"(?P<alcohol>\d{1,2}(?:\.\d{1,2})?)\s+(?:(?P<jan>\d{13}|\d{8})\s+)?(?P<country>[A-Za-z][A-Za-z .-]*)$")
+    for page_no, page in enumerate(reader.pages, 1):
+        text = page.extract_text() or ""
+        compact = re.sub(r"\s+", "", text)
+        if page_no == 1 and not all(h in compact for h in ("商品名称", "在庫数", "小売価格", "JAN", "国名")):
+            raise ValueError(f"page {page_no}: header_changed_or_no_text")
+        expected = Counter(re.findall(r"(?m)^\s*(\d{8})", text))
+        actual = Counter()
+        for line_no, line in enumerate(text.splitlines(), 1):
+            if not re.match(r"^\s*\d{8}", line):
+                continue
+            m = pattern.fullmatch(line.strip())
+            if not m:
+                raise ValueError(f"page {page_no}, line {line_no}: row_layout_changed")
+            raw = m.groupdict()
+            volume, case = int(raw["volume"]), int(raw["case"])
+            if volume <= 0 or case <= 0:
+                raise ValueError("invalid_volume_or_case")
+            vintage = raw["vintage"] or ""
+            row = row_contract(raw["sku"], raw["name"], "", raw["country"], "", "", vintage,
+                               volume, case, int(raw["price"].replace(",", "")), raw["stock"],
+                               page_no, line_no, {**raw, "原文": line}, jan=[raw["jan"]] if raw["jan"] else [])
+            row["PriceRaw"] = raw["price"]
+            row["Vintage"] = int(vintage) if re.fullmatch(r"[12]\d{3}", vintage) else None
+            row["AlcoholPercent"] = float(raw["alcohol"])
+            stock = raw["stock"]
+            row["Inventory"] = {"Quantity": int(stock) if stock.isdigit() else None,
+                                "Status": 3 if stock == "0" else 1, "RawValue": stock}
+            rows.append(row)
+            actual[raw["sku"]] += 1
+        if not expected or expected != actual:
+            raise ValueError(f"page {page_no}: coverage_mismatch")
+    unique(rows)
+    return rows, []
+
+
+def parse(data, supplier):
+    if _vendor_problem:
+        return {"ok": False, "code": "PdfReaderUnavailable", "message": "同梱PDF読取り環境とPythonの版・CPUが一致しません。",
+                "remedy": "管理担当者がLinux x64・Python 3.12用の配布物と実行パスを確認してください。既存Python環境を直接変更しないでください。"}
+    if not data.startswith(b"%PDF-"):
+        return {"ok": False, "code": "InvalidPdf", "message": "PDFのファイル形式が不正です。",
+                "remedy": "原本を開けるか確認し、正しいPDFを選択してください。"}
+    if supplier not in PARSERS:
+        return {"ok": False, "code": "UnsupportedPdfLayout", "message": "この取引先のPDF帳票は未対応です。",
+                "remedy": "取引先のExcel版または標準CSVを用意するか、この原本の読取り対応を依頼してください。"}
+    try:
+        # Third-party libraries must never print source content into the protocol output.
+        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
+            if supplier == "KINOSHITA":
+                rows, warnings = kinoshita(data)
+            else:
+                from pdf_import import PARSERS as existing
+                rows, warnings = existing[PARSERS[supplier]](data)
+                if supplier == "WINE_EXPERIENCE":
+                    rows = [wine_experience_row(r) for r in rows]
+            if not rows or len(rows) > 10000 or any(not r.get("SupplierProductCode") or not r.get("ProductNameJa") for r in rows):
+                raise ValueError("invalid_rows")
+        return {"ok": True, "version": "FolderPdf/1/" + PARSERS[supplier], "rows": rows,
+                "warnings": warnings, "hash": hashlib.sha256(data).hexdigest().upper()}
+    except ImportError:
+        return {"ok": False, "code": "PdfReaderUnavailable", "message": "サーバーのPDF読取り環境が不足しています。",
+                "remedy": "管理担当者がPDF読取り用Pythonとrequirements.txtの依存ライブラリを設定してください。"}
+    except Exception as exc:
+        # Only controlled categories and numeric positions enter the UI; never echo exceptions/source text.
+        reason = str(exc).lower()
+        page = re.search(r"page (\d{1,4})", reason)
+        line = re.search(r"(?:line|page \d{1,4}:)\s*(\d{1,4})", reason)
+        position = (f"PDF {page[1]}ページ" if page else "PDF") + (f"・行{line[1]}" if line else "")
+        cause = "帳票・列・商品行を安全に読み取れませんでした。"
+        if "header" in reason: cause = "列見出しが対応済み帳票と一致しません。"
+        elif "invalid table row" in reason or "row_layout" in reason: cause = "必須項目または列構成が対応済み帳票と一致しません。"
+        elif "coverage" in reason or "sequence" in reason: cause = "原典の商品行数と読取り結果が一致しません。"
+        elif "source title" in reason or "title/month" in reason: cause = "対応する表題・対象年月を検出できません。"
+        elif "legend" in reason: cause = "価格・在庫記号の凡例が対応済み帳票と異なります。"
+        elif "encrypted" in reason or "password" in reason: cause = "暗号化されているため読み取れません。"
+        return {"ok": False, "code": "PdfExtractionFailed", "message": position + "：" + cause,
+                "remedy": "表示箇所の原典と列・凡例を確認し、この帳票の読取り対応を依頼してください。暗号化PDFは解除済みコピー、画像PDFは文字を選択できるPDFまたはExcel版を用意してください。"}
+
+
+def wine_experience_row(r):
+    from supplier_pdfs import row_contract
+    stock = str(r["在庫(本)"])
+    row = row_contract(r["WEコード"], r["ワイン名"], r["生産者"], r["原産国"], r["産地"], r["種別"],
+                       str(r["VIN"]), r["容量(ml)"], r["入数"], r["小売価格"], stock,
+                       r["PDFページ"], 0, r, jan=[r["Barcode"]], notes=r["備考"])
+    row["Inventory"] = {"Quantity": r["在庫数量"] if isinstance(r["在庫数量"], int) else None,
+                        "Status": 3 if stock in ("0", "完売") else 1 if stock.isdigit() or stock in ("〇", "○") else 0,
+                        "RawValue": stock}
+    row["PriceRaw"] = str(r["小売価格"])
+    row["AlcoholPercent"] = float(r["Alc.%"]) if re.fullmatch(r"\d+(\.\d+)?", str(r["Alc.%"])) else None
+    return row
+
+
+if __name__ == "__main__":
+    # No input filenames or document text in diagnostics. One bounded JSON message on stdout.
+    data = sys.stdin.buffer.read(20_000_001)
+    result = parse(data, sys.argv[1]) if len(data) <= 20_000_000 else {"ok": False, "code": "FileTooLarge",
+        "message": "PDFが20MBを超えています。", "remedy": "20MB以下の資料に分けてください。"}
+    sys.stdout.buffer.write(json.dumps(result, ensure_ascii=False, allow_nan=False).encode("utf-8"))
diff --git a/catalog-search-poc/tools/pdf-folder/pdf_import.py b/catalog-search-poc/tools/pdf-folder/pdf_import.py
new file mode 100644
index 0000000..b79d415
--- /dev/null
+++ b/catalog-search-poc/tools/pdf-folder/pdf_import.py
@@ -0,0 +1,181 @@
+"""Shared local PDF catalog ingestion. Documents are data, never instructions."""
+from __future__ import annotations
+
+import argparse
+import csv
+import hashlib
+import io
+import json
+import os
+from pathlib import Path
+import re
+import tempfile
+from collections import Counter
+
+VERSION = 7
+PARSER_VERSIONS = {"diony": 11, "diony-news": 10}
+PRODUCT_CODE = r"WE[A-Z]{2}\d{4}[A-Z]?"
+
+
+def atomic_write(path: Path, data: bytes) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as stream:
+        temporary = Path(stream.name)
+        stream.write(data)
+    try:
+        os.replace(temporary, path)
+    finally:
+        temporary.unlink(missing_ok=True)
+
+
+def json_bytes(value) -> bytes:
+    return (json.dumps(value, ensure_ascii=False, indent=2) + "\n").encode("utf-8")
+
+
+def extract_pages(data: bytes) -> list[str]:
+    from pypdf import PdfReader
+    reader = PdfReader(io.BytesIO(data))
+    if reader.is_encrypted:
+        raise ValueError("Encrypted PDF is not supported. Supply an unlocked copy.")
+    return [page.extract_text(extraction_mode="layout") or "" for page in reader.pages]
+
+
+def wine_experience(data: bytes) -> tuple[list[dict], list[str]]:
+    import pdfplumber
+    columns = ["WEコード", "原産国", "産地", "生産者", "ワイン名", "VIN", "容量(ml)",
+               "入数", "種別", "Alc.%", "Barcode", "小売価格", "税込小売", "在庫(本)", "備考", "有機認証"]
+    rows, warnings = [], []
+    with pdfplumber.open(io.BytesIO(data)) as pdf:
+        if "THE WINE EXPERIENCE" not in (pdf.pages[0].extract_text() or ""):
+            raise ValueError("This PDF is not a Wine Experience catalog.")
+        for number, page in enumerate(pdf.pages, 1):
+            expected = Counter(re.findall(r"\bWE[A-Z0-9]+\b", page.extract_text() or ""))
+            actual = Counter()
+            for table in page.extract_tables():
+                for row in table:
+                    if not row or not re.fullmatch(PRODUCT_CODE, row[0] or ""):
+                        continue
+                    if len(row) != len(columns) or any(cell is None for cell in row):
+                        raise ValueError(f"Page {number}: unsupported table structure for {row[0]}")
+                    record = dict(zip(columns, [cell.strip() for cell in row]))
+                    record["PDFページ"] = number
+                    record["確認事項"] = ""
+                    for name in ("容量(ml)", "入数", "小売価格", "税込小売"):
+                        if not re.fullmatch(r"\d+(?:,\d{3})*", record[name]):
+                            raise ValueError(f"Page {number}: invalid {name}: {record[name]}")
+                        record[name] = int(record[name].replace(",", ""))
+                    stock = record["在庫(本)"]
+                    record["在庫数量"] = int(stock) if stock.isdigit() else (0 if stock == "完売" else "")
+                    record["在庫状態"] = "200本以上" if stock in ("〇", "○") else ("完売" if stock == "完売" else "在庫あり" if stock.isdigit() and int(stock) > 0 else "在庫なし" if stock == "0" else "不明")
+                    if record["在庫状態"] == "不明":
+                        warnings.append(f"{record['WEコード']}: unknown stock notation {stock!r}")
+                    capacities = re.findall(r"(\d+)\s*ML", record["ワイン名"], re.I)
+                    if capacities and any(int(cap) != record["容量(ml)"] for cap in capacities):
+                        record["確認事項"] = "商品名の容量と容量欄が不一致（原表の容量欄を保持）"
+                        warnings.append(f"{record['WEコード']}: {record['確認事項']}")
+                    actual[record["WEコード"]] += 1
+                    rows.append(record)
+            if actual != expected:
+                raise ValueError(f"Page {number}: table coverage mismatch: expected {expected}, got {actual}")
+    if not rows:
+        raise ValueError("No products extracted")
+    codes = Counter(row["WEコード"] for row in rows)
+    if any(count != 1 for count in codes.values()):
+        raise ValueError("Duplicate product codes; review source before importing")
+    return rows, warnings
+
+
+try:
+    from .supplier_pdfs import finesse, royal, toyotsu
+except ImportError:
+    from supplier_pdfs import finesse, royal, toyotsu
+
+try:
+    from .daiei_pdf import daiei
+except ImportError:
+    from daiei_pdf import daiei
+
+try:
+    from .diony_pdf import diony, diony_news
+except ImportError:
+    from diony_pdf import diony, diony_news
+
+try:
+    from .arcan_pdf import arcan
+except ImportError:
+    from arcan_pdf import arcan
+
+PARSERS = {"arcan": arcan, "diony": diony, "diony-news": diony_news, "daiei": daiei, "wine-experience": wine_experience, "finesse": finesse, "royal": royal, "toyotsu": toyotsu}
+
+
+def import_pdf(source: Path, output: Path, name: str | None = None, parser: str = "text") -> dict:
+    source = source.resolve(strict=True)
+    name = name or source.stem
+    if name in ("", ".", "..") or re.search(r'[\\/:*?"<>|]', name):
+        raise ValueError("Name must be a single safe filename stem")
+    if source.suffix.lower() != ".pdf":
+        raise ValueError("Source must be a PDF")
+    data = source.read_bytes()
+    if not data.startswith(b"%PDF-"):
+        raise ValueError("Source does not have a PDF signature")
+    version = PARSER_VERSIONS.get(parser, VERSION)
+    digest = hashlib.sha256(data).hexdigest()
+    output = output.resolve()
+    target = output / f"{name}.pdf"
+    meta_path = output / f"{name}.meta.json"
+    if target.exists() and hashlib.sha256(target.read_bytes()).hexdigest() != digest:
+        raise ValueError(f"Different PDF already exists: {target}. Use a new name.")
+    if meta_path.exists():
+        previous = json.loads(meta_path.read_text(encoding="utf-8"))
+        if previous.get("sha256") == digest and previous.get("source_filename") == source.name and previous.get("parser") == parser and previous.get("version") == version:
+            artifacts = previous.get("artifacts", {})
+            if artifacts and all((output / file).is_file() and hashlib.sha256((output / file).read_bytes()).hexdigest() == sha for file, sha in artifacts.items()):
+                return {**previous, "result": "unchanged"}
+    # Parse and validate completely before publishing any output.
+    texts = extract_pages(data)
+    empty = [i for i, text in enumerate(texts, 1) if not text.strip()]
+    if not texts or empty:
+        raise ValueError(f"Text extraction incomplete; OCR/review required for pages {empty}")
+    payloads = {f"{name}.pdf": data,
+                f"{name}.txt": "\n\n".join(f"--- PDF page {i} ---\n{text}" for i, text in enumerate(texts, 1)).encode("utf-8"),
+                f"{name}.pages.json": json_bytes([{"page": i, "text": text} for i, text in enumerate(texts, 1)])}
+    warnings, count = [], None
+    if parser != "text":
+        records, warnings = PARSERS[parser](data)
+        count = len(records)
+        payloads[f"{name}.products.json"] = json_bytes(records)
+        stream = io.StringIO(newline="")
+        writer = csv.DictWriter(stream, fieldnames=list(records[0]))
+        writer.writeheader()
+        writer.writerows(records)
+        payloads[f"{name}.csv"] = stream.getvalue().encode("utf-8-sig")
+    metadata = {"version": version, "source_filename": source.name, "sha256": digest,
+                "parser": parser, "pages": len(texts), "page_characters": [len(t) for t in texts],
+                "product_count": count, "warnings": warnings,
+                "artifacts": {file: hashlib.sha256(content).hexdigest() for file, content in payloads.items()}}
+    for file, content in payloads.items():
+        destination = output / file
+        if destination.exists() and destination.read_bytes() == content:
+            continue
+        atomic_write(destination, content)
+    # Metadata is the completion marker; interrupted writes are repaired on the next run.
+    atomic_write(meta_path, json_bytes(metadata))
+    return {**metadata, "result": "imported"}
+
+
+def main() -> None:
+    cli = argparse.ArgumentParser(description=__doc__)
+    cli.add_argument("source", type=Path)
+    cli.add_argument("--output", type=Path, default=Path("catalogs"))
+    cli.add_argument("--name")
+    cli.add_argument("--parser", choices=["text", *PARSERS], default="text")
+    args = cli.parse_args()
+    try:
+        result = import_pdf(args.source, args.output, args.name, args.parser)
+    except (ValueError, OSError) as error:
+        cli.exit(1, f"Import failed: {error}\n")
+    print(json.dumps(result, ensure_ascii=False, indent=2))
+
+
+if __name__ == "__main__":
+    main()
